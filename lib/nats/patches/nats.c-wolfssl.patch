@@ -694,6 +700,34 @@ natsOptions_SetCertificatesChain(natsOptions *opts, const char *certStr, const c
     LOCK_AND_CHECK_OPTIONS(opts, 0);
 
     s = _getSSLCtx(opts);
+#if defined(NATS_HAS_WOLFSSL)
+    // wolfSSL's compat SSL_CTX_use_PrivateKey() rejects the EVP_PKEY that
+    // its own PEM_read_bio_PrivateKey() returns, so load both PEM strings
+    // with wolfSSL's native buffer calls.  The explicit key check refuses
+    // a key that does not match the certificate (OpenSSL does the same
+    // when the key types agree).
+    if (s == NATS_OK)
+    {
+        int rc = wolfSSL_CTX_use_certificate_buffer(opts->sslCtx->ctx,
+                    (const unsigned char*) certStr, (long) strlen(certStr),
+                    WOLFSSL_FILETYPE_PEM);
+        if (rc != WOLFSSL_SUCCESS)
+            s = nats_setError(NATS_SSL_ERROR, "Error using certificate: %s",
+                              ERR_reason_error_string((unsigned long) rc));
+    }
+    if (s == NATS_OK)
+    {
+        int rc = wolfSSL_CTX_use_PrivateKey_buffer(opts->sslCtx->ctx,
+                    (const unsigned char*) keyStr, (long) strlen(keyStr),
+                    WOLFSSL_FILETYPE_PEM);
+        if (rc != WOLFSSL_SUCCESS)
+            s = nats_setError(NATS_SSL_ERROR, "Error using private key: %s",
+                              ERR_reason_error_string((unsigned long) rc));
+        else if (SSL_CTX_check_private_key(opts->sslCtx->ctx) != 1)
+            s = nats_setError(NATS_SSL_ERROR, "%s",
+                              "Error using private key: key does not match the certificate");
+    }
+#else
     if (s == NATS_OK)
     {
         X509 *cert = NULL;
@@ -741,6 +775,7 @@ natsOptions_SetCertificatesChain(natsOptions *opts, const char *certStr, const c
         if (bio != NULL)
             BIO_free(bio);
     }
+#endif
 
